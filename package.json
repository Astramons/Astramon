{
  "name": "astramon",
  "version": "0.1.0",
  "description": "Astramon is a bright 16-bit Solana card summon, NFT collection, and marketplace interface powered by the Astra token.",
  "private": true,
  "license": "UNLICENSED",
  "homepage": "https://astramon.fun",
  "repository": {
    "type": "git",
    "url": "https://github.com/Astramons/Astramon.git"
  },
  "bugs": {
    "url": "https://github.com/Astramons/Astramon/issues"
  },
  "scripts": {
    "build:mint": "esbuild scripts/astramon-mint-entry.js --bundle --format=iife --global-name=AstramonCandyMintBundle --outfile=assets/astramon-mint.js",
    "validate": "node scripts/validate-site.mjs"
  },
  "keywords": [
    "astramon",
    "astra",
    "solana",
    "nft",
    "pixel-art",
    "web3"
  ],
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@metaplex-foundation/mpl-candy-machine": "^6.1.0",
    "@metaplex-foundation/mpl-token-metadata": "^3.4.0",
    "@metaplex-foundation/mpl-toolbox": "^0.11.4",
    "@metaplex-foundation/umi": "^1.5.1",
    "@metaplex-foundation/umi-bundle-defaults": "^1.5.1",
    "@metaplex-foundation/umi-signer-wallet-adapters": "^1.5.1",
    "esbuild": "^0.28.0"
  }
}
